{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "redirects": [
    { "source": "/catering/ort/:city", "destination": "/catering/:city", "permanent": true },
    { "source": "/planner/ort/:city", "destination": "/planner/:city", "permanent": true },
    { "source": "/signup/customer", "destination": "/auth?signup=customer", "permanent": true },
    { "source": "/signup/caterer", "destination": "/auth?signup=caterer", "permanent": true },
    { "source": "/signup", "destination": "/auth", "permanent": true },
    { "source": "/caterers", "destination": "/catering", "permanent": true },
    {
      "source": "/blog/restaurant-bestellen-ohne-provision-speisely",
      "destination": "/blog/restaurant-bestellen-direkt-speisely",
      "permanent": true
    },
    {
      "source": "/order",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self), payment=(self)"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "on"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ]
}
